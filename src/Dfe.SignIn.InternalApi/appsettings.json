{
  //
  // IMPORTANT:
  // ==========
  //
  // This file includes sensible default option values for production environments.
  //
  //   * DO NOT put secrets in this file - Use `dotnet user-secrets` instead.
  //
  //   * Omit sensitive options entirely.
  //
  "Notifications": {
    "SupportTeamEmail": "test@Test.com"
  },
  "Platform": {
    "SurveyUrl": "https://survey.localhost",
    "HelpUrl": "http://localhost:5012",
    "ManageUrl": "https://manage.localhost",
    "ProfileUrl": "http://localhost:41011",
    "ServicesUrl": "https://services.localhost",
    "SupportUrl": "https://support.localhost",
    "CookiesUrl": "http://localhost:5012/cookies",
    "TermsUrl": "http://localhost:5012/terms",
    "PrivacyUrl": "http://localhost:5012/privacy",
    "AccessibilityUrl": "https://help.localhost/accessibility-statement",
    "ContactUrl": "http://localhost:5012/contact-us"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Dfe.SignIn": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AzureMonitor": {
    "SamplingRatio": "0.1"
  },
  "AllowedHosts": "*",
  "Audit": {
    "ApplicationName": "InternalApi"
  },
  "HttpResiliency": {
    "NodeApiDefault": {
      "Timeout": 10
    }
  },
  "EmailRestrictions": {
    "BlockedDomains": [
      "gmail.com",
      "hotmail.com",
      "outlook.com"
    ],
    "BlockedNames": [
      "test",
      "admin",
      "noreply"
    ],
    "GenericEmailStrings": [
      "test@test.com"
    ]
  },
  "Messaging": {
    "Enabled": true
  },
  "BullMq": {
    "DatabaseIndex": 4,
    "RemoveOnCompleteAgeSeconds": 3600,
    "RemoveOnCompleteCount": 50,
    "RemoveOnFailAgeSeconds": 43200
  }
}
