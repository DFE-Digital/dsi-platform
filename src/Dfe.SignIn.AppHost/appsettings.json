{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "NodePlatformDirectory": "../../../dsi-node-platform", // point to the directory holding all the node platform services, e.g. login.dfe.profile
  "NodeEnvFileName": "tran-local.env", // the name of the environment file to use for node services, e.g. .env, local.env, tran-local.env
  "Components": {
    "DotNet": {
      "Help": false,
      "Profile": true,
      "PublicApi": true
    },
    "Node": {
      "Oidc": false,
      "Interactions": false,
      "Services": false
    },
    "Tools": {
      "TlsProxy": false
    }
  }
}
