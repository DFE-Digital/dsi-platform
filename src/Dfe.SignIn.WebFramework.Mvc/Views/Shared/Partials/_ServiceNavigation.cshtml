<govuk-service-navigation service-name="@(ViewData[DsiLayoutConstants.ServiceName] ?? "DfE Sign‑in")" service-url="/">
    @{
        var navObj = ViewData[DsiLayoutConstants.ServiceNavigationItems];
    }
    @if (navObj is NavigationItemViewModel[] items && items.Any())
{
        <govuk-service-navigation-nav>

            @foreach (var item in items)
            {
                @switch (item)
                {
                    case CountNavigationItemViewModel countItem:
                        <govuk-service-navigation-nav-item href="@countItem.Href" active="@countItem.IsActive" >
                            @countItem.Text
                            @if (countItem.Count > 0)
                            {
                                <span class="govuk-notification-badge">@countItem.Count</span>
                            }
                        </govuk-service-navigation-nav-item>
                        break;

                    case StandardNavigationItemViewModel standardItem:
                        <govuk-service-navigation-nav-item href="@standardItem.Href" active="@standardItem.IsActive">
                            @standardItem.Text
                        </govuk-service-navigation-nav-item>
                        break;
                }
            }
        </govuk-service-navigation-nav>
    }
</govuk-service-navigation>
