@using Dfe.SignIn.Web.Profile.Services
@inject IServiceNavigationBuilder NavigationBuilder

@{
    Layout = "_DsiLayout";

    ViewData[DsiLayoutConstants.ServiceName] = "DfE Sign-in";

    ViewData[DsiLayoutConstants.ServiceNavigationItems] = await NavigationBuilder.Build(User);

    if (User.Identity?.IsAuthenticated == true)
    {
        ViewData[DsiLayoutConstants.SignOutUrl] = Url.Action(
            nameof(AuthController.SignOut),
            MvcNaming.Controller<AuthController>()
        );
    }
}
